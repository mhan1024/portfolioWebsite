<!doctype html>
<html lang="en">

<head>
	<meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Projects</title>

    <!-- Style Sheet Connection -->
    <link rel="stylesheet" href="style.css" type="text/css">
    <!-- Link to JavaScript (SERVER) code -->
    <script src="./server.js"></script>
    <!-- Link to JavaScript (ADDITIONAL FUNCTIONALITY) code -->
    <script src="./helper.js"></script>

    <!-- Double Arrow Icon -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=keyboard_double_arrow_right" />
</head>

<body>
    <div class="slideshow-container">
        <!-- PREV BUTTON -->
        <button type="button" id="prev_button" onclick='prev(<%= JSON.stringify(cardCollection) %>, <%= JSON.stringify(cardsIdx) %>)'>&#10094;</button>
    
        <!-- CARD 1 -->
        <div class="cards">
    
            <%- card1 %>
        
        </div>
    
        <!-- CARD 2 -->
        <div class="cards">
    
            <%- card2 %>
            
        </div>
    
        <!-- CARD 3 -->
        <div class="cards">
    
            <%- card3 %>
            
        </div>
    
        <!-- NEXT BUTTON -->
        <button type="button" id="next_button" onclick='next(<%= JSON.stringify(cardCollection) %>, <%= JSON.stringify(cardsIdx) %>)'>&#10095;</button>
    </div>

    <div id="overlay" onclick="off()">
        <div id="inner_proj">
        </div>
    </div>
    
</body>
</html>

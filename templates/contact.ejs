<!doctype html>
<html lang="en">

<head>
	<meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Contact</title>

    <!-- Style Sheet Connection -->
    <link rel="stylesheet" href="style.css" type="text/css">
    <!-- Link to JavaScript code -->
    <script src="./server.js"></script>
    <!-- Link to JavaScript (ADDITIONAL FUNCTIONALITY) code -->
    <script src="./helper.js"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

</head>

<body id="contact_body">
    <header>
        <div class="tabOuter">
            <%- include('./nav_bar') %>
        </div>
    </header>

    <div id="oven_outer">
        <div id="oven_inner">
            <div id="oven_dials">
                <button type="button" id="contact_form" onclick='changeWindow(1)'>Contact</button>
                <button type="button" id="send_resume" onclick='changeWindow(2)'>Resume</button>
                <button type="button" id="social_links" onclick='changeWindow(3)'>Socials</button>
            </div>
    
            <hr>
    
            <div id="oven_handle" onclick='resetWindow()'>
                <span class="circle"></span>
                <hr id="handle_bar">
                <span class="circle"></span>
            </div>
    
            <div id="oven_window">
                <%- oven_window_display %>
            </div>
        </div>
        
        <div id="oven_bottom">
            <div id="left_foot"></div>
            <div id="right_foot"></div>
        </div>
    </div>
</body>

</html>